# Cloudflare Pages response headers.
# Rules are matched top-down; the most specific match wins.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
  X-Frame-Options: SAMEORIGIN

# Fingerprinted-by-content assets: images, icons, fonts. These change name
# when they change, so they can be cached hard.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The stylesheet and script keep stable names, so cache them briefly and
# let the CDN revalidate. Long enough to help repeat views, short enough
# that a redeploy is visible within the hour.
/styles.css
  Cache-Control: public, max-age=3600, must-revalidate

/script.js
  Cache-Control: public, max-age=3600, must-revalidate

# HTML should always be revalidated so a redeploy shows up immediately.
/*.html
  Cache-Control: public, max-age=0, must-revalidate
