#!/bin/sh
# Refuse a push that would fail the deploy.
#
# The workflow will not publish a site whose links are malformed or whose
# files are missing, and when it stops the previous version stays live — so
# a bad push looks like a successful one until you check GitHub. This runs
# the same checks first.
#
# Install it with:
#     python install-hooks.py
#
# Skip it once, if you really mean to:
#     git push --no-verify

echo "Running check.py before pushing..."
echo

if ! python3 check.py; then
  echo
  echo "Push stopped. The deploy would have failed on this, and the old site"
  echo "would have stayed live. Fix the above, or push with --no-verify."
  exit 1
fi

# build.py is the source of truth: CI regenerates the pages from it. If the
# rebuild just changed a file that is not staged, the pages you are pushing
# are not the pages CI will publish.
DRIFT=$(git diff --name-only -- '*.html' sitemap.xml robots.txt)
if [ -n "$DRIFT" ]; then
  echo
  echo "These were regenerated by the check and differ from what you committed:"
  echo "$DRIFT" | sed 's/^/  /'
  echo
  echo "CI rebuilds from build.py, so it would publish this version, not yours."
  echo "Commit them and push again:"
  echo "  git add -A && git commit --amend --no-edit"
  exit 1
fi

echo
exit 0
